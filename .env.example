# .env.example
# Server
NODE_ENV=development
PORT=4000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/erp_expenses_app
MONGO_DB_NAME=erp_expenses_app

# JWT (use long random strings in real .env)
ACCESS_TOKEN_SECRET=replace_with_a_long_random_access_secret
REFRESH_TOKEN_SECRET=replace_with_a_long_random_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS / App URLs
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
VERIFY_EMAIL_PATH=/auth/verify-email
RESET_PASSWORD_PATH=/auth/reset-password
APP_NAME=ERP Expenses

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=ERP Expenses
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# TimeZone
SCHEDULE_TZ_DEFAULT=America/Mexico_City